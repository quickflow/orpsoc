board_system_create -haps -name Test_board
board_system_create -add HAPS100_4F -name mb1


board_system_configure -top_io  { mb1.A9 mb1.A5 mb1.A4  mb1.A1 mb1.A2 mb1.A3 mb1.A10 mb1.A11 mb1.A12 mb1.A13 mb1.A14 mb1.A15 mb1.A16 mb1.B9 mb1.B5 mb1.B4  mb1.B1 mb1.B2 mb1.B3 mb1.B10}
board_system_configure -voltage { mb1.A9 mb1.A5 mb1.A4 mb1.A1 mb1.A2 mb1.A3 mb1.A10 mb1.A11 mb1.A12 mb1.A13 mb1.A14 mb1.A15 mb1.A16 mb1.B9 mb1.B5 mb1.B4  mb1.B1 mb1.B2 mb1.B3 mb1.B10} 1.8

