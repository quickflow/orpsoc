proc Start_callback {module sampleNumber ClockCycle isLastNotify} {
global wave_enable
global fwc_fid_design

set wave_enable 1
puts "Start__notifier_done = $isLastNotify"
puts "Start__notifier_cycle = $ClockCycle"
run
}

proc End_callback {module sampleNumber ClockCycle isLastNotify} {
global wave_enable
global fwc_fid_design

set wave_enable 0
puts "End__notifier_done = $isLastNotify"
puts "End__notifier_cycle = $ClockCycle"
}

proc do_finish {} {
 global zfinished
 puts "#### Finish called ####"
 set zfinished 1
 ccall -flush
 quit
}
### dollar_finish for $finish, must put before start_zebu
dollar_finish -enable do_finish

puts "#######################################"
puts "Configuring ZRCI"
puts "#######################################"
config action_log action.log
config default_clock both tickClk
config zebu_work ./zcui.work/zebu.work
#source lib.ucli
#zemi3 -enable
#zemi3 -config [config zebu_work]/xtor_dpi.lst
#zemi3 -xtor dpi_xtor -lib zcui.work/zebu.work/dpi_xtor.so

puts "#######################################"
puts "Setting up Database"
puts "#######################################"

set db_name ./ZRCI
set cnt 1
while { [file exists ${db_name}_${cnt}] } {incr cnt}
set db_name ${db_name}_${cnt}
puts "Setting zRci database name to $db_name"

start_zebu $db_name

ccall -load zcui.work/zebu.work/grp0_ccall.so
puts "test begin time [exec date]"
set begin_run_time [clock clicks -milliseconds]
ccall -enable_synchronization
ccall -enable

set qiwc_fid [dump -file "qiwc_dump"  -type qiwc]
dump -fid $qiwc_fid -add_value_set {qiwc} 
#dump -enable -fid $qiwc_fid
run
